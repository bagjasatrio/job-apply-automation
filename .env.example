# Kredensial Email (Gmail App Password)
EMAIL_USER=user@example.com
EMAIL_PASSWORD=your-app-password
IMAP_SERVER=imap.gmail.com
SMTP_SERVER=smtp.gmail.com

# Integrasi Tracker (PILIH SALAH SATU):
# Opsi 1: Google Apps Script Webhook (Paling Mudah, TANPA credentials.json/password)
# GOOGLE_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Opsi 2: Google Service Account Resmi (Butuh GCP credentials.json)
# GOOGLE_SHEET_ID=your_google_sheet_id_here
# SERVICE_ACCOUNT_FILE=credentials.json

# Opsi 3: Local CSV (applications.csv) -> Default otomatis jika opsi 1 & 2 kosong! Tanpa setup apa pun.

# Path File CV (Bahasa Indonesia & English)
CV_ID_PATH="CV_Kandidat.pdf"
CV_EN_PATH="CV_Candidate_EN.pdf"

# Google AI Studio API Key (Untuk AI Matcher & ATS Resume Tailoring)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Notifikasi Telegram Bot ke HP (Opsional)
# Buat bot via @BotFather -> dapat token
# Chat ID via @userinfobot -> dapat id
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRstuVWXyz"
TELEGRAM_CHAT_ID="123456789"
